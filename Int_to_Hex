
#include <unistd.h>

void int_to_hex(int n)
{
    char c;

    if (n == -2147483648)
    {
        write(1, "-80000000", 9);
        return;
    }

    if (n < 0)
    {
        write(1, "-", 1);
        n = -n;
    }

    if (n >= 16)
        int_to_hex(n / 16);

    if (n % 16 < 10)
        c = (n % 16) + '0';
    else
        c = (n % 16) - 10 + 'a';

    write(1, &c, 1);
}

int main(void)
{
    int_to_hex(10);
    write(1, "\n", 1);

    int_to_hex(255);
    write(1, "\n", 1);

    int_to_hex(1000);
    write(1, "\n", 1);

    int_to_hex(-42);
    write(1, "\n", 1);

    return (0);
}
